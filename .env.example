APP_ENV=production
APP_BASE_URL=https://api.example.com
FRONTEND_BASE_URL=https://ads.example.com

# Supabase
SUPABASE_URL=https://mttpwqadkthuipsthiai.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_ANON_KEY=your_anon_key

# Google Ads API
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_USE_PROTO_PLUS=True

# AI API
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o
AI_REQUEST_TIMEOUT_SECONDS=120

# Safety
GLOBAL_DAILY_MUTATE_LIMIT=500
DEFAULT_SITE_DAILY_ACTION_LIMIT=50
DEFAULT_BUDGET_CHANGE_RATE_CAP=0.15
ENABLE_VALIDATE_ONLY=true
ENABLE_PRODUCTION_MUTATE=false

# Scheduler
ENABLE_SCHEDULER=true
TIMEZONE=Asia/Shanghai
